# Required whenever the MCP adapter is selected and in every production runtime.
ORACLE_MCP_URL=https://oracle.example.test/mcp

# Optional. Defaults to "mcp". "fixtures" is accepted only in development/test.
ORACLE_DATA_SOURCE=mcp

# Required in every runtime. "memory" is explicit and development/test-only.
LEAD_REPOSITORY=postgres

# Required in production and whenever LEAD_REPOSITORY=postgres.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Required in every runtime. Use at least 32 random characters.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Required in production. Model IDs use the provider/model form.
AI_PROVIDER=gateway
AI_MODEL=provider/model-id

# Optional outside Vercel when OIDC is unavailable. Keep the real value out of git.
AI_GATEWAY_API_KEY=replace-with-gateway-api-key
